{
	"name": "@blackswampai/n8n-nodes-openobserve",
	"version": "0.1.2",
	"description": "Independent n8n community integration for OpenObserve",
	"license": "MIT",
	"homepage": "https://github.com/BlackSwampAI/n8n-nodes-openobserve#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"openobserve",
		"observability",
		"logs",
		"metrics",
		"traces"
	],
	"author": {
		"name": "Christopher J. Nelson",
		"email": "christopherjnelson@proton.me"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/BlackSwampAI/n8n-nodes-openobserve.git"
	},
	"bugs": {
		"url": "https://github.com/BlackSwampAI/n8n-nodes-openobserve/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
		"test": "vitest run",
		"test:unit": "vitest run",
		"release:check": "node scripts/release-check.mjs",
		"package:check": "npm run release:check && node scripts/package-check.mjs",
		"smoke:load": "node scripts/node-load-smoke.mjs",
		"smoke:install": "node scripts/package-install-smoke.mjs",
		"scan:source": "node scripts/scan-source.mjs",
		"scan:published": "node scripts/scan-published.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/OpenObserveApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/OpenObserve/OpenObserve.node.js",
			"dist/nodes/OpenObserveTrigger/OpenObserveTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.46.4",
		"@n8n/scan-community-package": "0.34.0",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "20.2.0",
		"typescript": "5.9.2",
		"vitest": "4.1.11"
	},
	"allowScripts": {
		"eslint-plugin-n8n-nodes-base": false
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=22.22.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
