{
	"name": "@blackswampai/n8n-nodes-openobserve",
	"version": "0.1.0",
	"description": "Independent n8n community integration for OpenObserve",
	"license": "MIT",
	"homepage": "https://github.com/BlackSwampAI/n8n-nodes-openobserve#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"openobserve",
		"observability",
		"logs",
		"metrics",
		"traces"
	],
	"author": {
		"name": "Black Swamp AI",
		"email": "christopherjnelson@proton.me"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/BlackSwampAI/n8n-nodes-openobserve.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"typecheck": "tsc --noEmit",
		"test": "node --test tests/**/*.test.mjs",
		"release:check": "node scripts/release-check.mjs",
		"package:check": "npm run release:check && npm pack --dry-run --cache /tmp/n8n-nodes-openobserve-npm-cache",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"nodes": [
			"dist/nodes/OpenObserve/OpenObserve.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.42.2",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "20.2.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=22.22.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
